generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(USER)
  status       String     @default("Active")
  createdBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  goats        Goat[]
  breedings    Breeding[]
  kids         Kid[]
  goatPurchases GoatPurchase[]
  sales        Sale[]
  expenses     Expense[]
  workers      Worker[]
  workerPayments WorkerPayment[]
  inventoryItems InventoryItem[]
  inventoryTransactions InventoryTransaction[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  sku         String      @unique
  price       Decimal
  unit        String      @default("liter")
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)
  total      Decimal
  notes      String?
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
}

model Goat {
  id                String     @id @default(cuid())
  tagNumber         String     @unique
  name              String?
  breed             String
  gender            String
  dateOfBirth       DateTime
  purchaseDate      DateTime?
  purchasePrice     Decimal?
  currentValue      Decimal
  weight            Decimal
  color             String
  healthStatus      String
  vaccinationStatus String
  status            String     @default("Active")
  imageUrl          String?
  notes             String?
  fatherId          String?
  motherId          String?
  father            Goat?      @relation("GoatFather", fields: [fatherId], references: [id], onDelete: SetNull)
  mother            Goat?      @relation("GoatMother", fields: [motherId], references: [id], onDelete: SetNull)
  childrenAsFather  Goat[]     @relation("GoatFather")
  childrenAsMother  Goat[]     @relation("GoatMother")
  breedingsAsFemale Breeding[] @relation("BreedingFemale")
  breedingsAsMale   Breeding[] @relation("BreedingMale")
  kidsAsMother      Kid[]      @relation("KidMother")
  kidsAsFather      Kid[]      @relation("KidFather")
  kidProfile        Kid?       @relation("KidAsGoat")
  purchases         GoatPurchase[]
  sales             Sale[]
  ownerId           String
  owner             User       @relation(fields: [ownerId], references: [id])
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model Breeding {
  id              String    @id @default(cuid())
  femaleGoatId    String
  maleGoatId      String?
  femaleGoat      Goat      @relation("BreedingFemale", fields: [femaleGoatId], references: [id])
  maleGoat        Goat?     @relation("BreedingMale", fields: [maleGoatId], references: [id], onDelete: SetNull)
  breedingDate    DateTime
  expectedDueDate DateTime
  actualBirthDate DateTime?
  status          String
  notes           String?
  kids            Kid[]
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ownerId])
  @@index([femaleGoatId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model Kid {
  id                String    @id @default(cuid())
  tagNumber         String    @unique
  name              String?
  gender            String
  dateOfBirth       DateTime
  motherId          String
  fatherId          String?
  mother            Goat      @relation("KidMother", fields: [motherId], references: [id])
  father            Goat?     @relation("KidFather", fields: [fatherId], references: [id], onDelete: SetNull)
  /// Linked animal record in the main herd (created on birth)
  goatId            String?   @unique
  goat              Goat?     @relation("KidAsGoat", fields: [goatId], references: [id], onDelete: SetNull)
  weight            Decimal
  healthStatus      String
  vaccinationStatus String
  status            String    @default("Active")
  imageUrl          String?
  notes             String?
  breedingId        String?
  breeding          Breeding? @relation(fields: [breedingId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id])
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerId])
  @@index([motherId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model GoatPurchase {
  id            String    @id @default(cuid())
  date          DateTime
  goatId        String?
  tagNumber     String
  seller        String
  purchasePrice Decimal
  paymentStatus String
  notes         String?
  goat          Goat?     @relation(fields: [goatId], references: [id], onDelete: SetNull)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId])
  @@index([tagNumber])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model Sale {
  id            String    @id @default(cuid())
  date          DateTime
  tagNumber     String
  goatId        String?
  goat          Goat?     @relation(fields: [goatId], references: [id], onDelete: SetNull)
  buyer         String
  salePrice     Decimal
  paymentStatus String
  paymentMethod String
  notes         String?
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId])
  @@index([tagNumber])
  @@index([goatId])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model Expense {
  id            String    @id @default(cuid())
  date          DateTime
  description   String
  category      String
  amount        Decimal
  paymentMethod String
  notes         String?
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId])
  @@index([category])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model Worker {
  id          String          @id @default(cuid())
  name        String
  phone       String
  role        String
  salary      Decimal
  joiningDate DateTime
  status      String          @default("Active")
  notes       String?
  payments    WorkerPayment[]
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id])
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model WorkerPayment {
  id            String    @id @default(cuid())
  workerId      String
  worker        Worker    @relation(fields: [workerId], references: [id])
  date          DateTime
  /// Month this payment counts toward, e.g. "2026-09"
  forMonth      String
  type          String
  amount        Decimal
  paymentMethod String
  notes         String?
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workerId])
  @@index([forMonth])
  @@index([ownerId])
  @@index([deletedAt])
}

model InventoryItem {
  id            String                 @id @default(cuid())
  name          String
  category      String
  unit          String
  currentStock  Decimal
  minimumStock  Decimal
  cost          Decimal
  dailyUsage    Decimal?
  expiryDate    DateTime?
  supplier      String?
  notes         String?
  transactions  InventoryTransaction[]
  ownerId       String
  owner         User                   @relation(fields: [ownerId], references: [id])
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([ownerId])
  @@index([category])
  @@index([deletedAt])
  @@index([deletedAt, ownerId])
}

model InventoryTransaction {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  date      DateTime
  quantity  Decimal
  direction String
  reason    String?
  supplier  String?
  cost      Decimal?
  notes     String?
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([itemId])
  @@index([ownerId])
  @@index([deletedAt])
}
